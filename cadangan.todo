//portofolio yang pertama dan menjadi portofolio cadangan 

"use client";
import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Github, Mail, MapPin, Code2, Database, Layout, ExternalLink, ChevronRight, Smartphone, Terminal, Cpu } from 'lucide-react';

// DATA SOURCE
const DATA = {
  name: "Satria Maulana Asrul",
  role: "Software Engineering Student",
  school: "SMK Assalaam Bandung",
  email: "satmul.aja009@gmail.com",
  github: "github.com/satmul-desu",
  address: "Kompleks Rancamayar Regency 1",
  skills: [
    { name: "HTML", level: 95 }, { name: "CSS", level: 90 },
    { name: "JS", level: 90 }, { name: "PHP", level: 95 },
    { name: "Node.js", level: 88 }, { name: "MySQL", level: 95 },
    { name: "PgSQL", level: 98 }
  ],
  projects: [
    {
      title: "Fullstack Application",
      category: "Management System",
      desc: "Platform manajemen data karyawan dengan fitur autentikasi, CRUD, dan dashboard admin.",
      tech: ["PHP", "PgSQL", "Tailwind"]
    },
    {
      title: "E-Commerce Website",
      category: "Digital Store",
      desc: "Website toko online dengan fitur cart & checkout yang dinamis dan responsif.",
      tech: ["Node.js", "MySQL", "Express"]
    },
    {
      title: "Sistem Kasir (POS)",
      category: "Business Tools",
      desc: "Aplikasi kasir sederhana untuk UMKM dengan laporan stok dan penjualan real-time.",
      tech: ["PHP", "SQLite", "JavaScript"]
    }
  ]
};

export default function SatriaPortfolio() {
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });
  const [isScrolled, setIsScrolled] = useState(false);

  // Efek Javascript Modern: Tracking Mouse & Scroll
  useEffect(() => {
    const handleMouseMove = (e: MouseEvent) => setMousePos({ x: e.clientX, y: e.clientY });
    const handleScroll = () => setIsScrolled(window.scrollY > 50);
    
    window.addEventListener("mousemove", handleMouseMove);
    window.addEventListener("scroll", handleScroll);
    return () => {
      window.removeEventListener("mousemove", handleMouseMove);
      window.removeEventListener("scroll", handleScroll);
    };
  }, []);

  return (
    <main className="min-h-screen bg-[#050505] text-zinc-100 selection:bg-blue-500/30 overflow-x-hidden cursor-none">
      
      {/* 1. TECH CURSOR (Efek Berteknologi) */}
      <motion.div 
        className="fixed w-6 h-6 bg-blue-500 rounded-full pointer-events-none z-[9999] mix-blend-difference"
        animate={{ x: mousePos.x - 12, y: mousePos.y - 12 }}
        transition={{ type: "spring", damping: 20, stiffness: 250, mass: 0.5 }}
      />
      <div className="fixed inset-0 z-0 opacity-30 pointer-events-none">
        <div className="absolute top-0 left-0 w-full h-full bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20"></div>
        <motion.div 
          className="absolute w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[120px]"
          animate={{ x: mousePos.x - 250, y: mousePos.y - 250 }}
        />
      </div>

      {/* 2. DYNAMIC NAVBAR */}
      <nav className={`fixed top-0 w-full z-50 transition-all duration-500 px-10 py-5 flex justify-between items-center ${
        isScrolled ? "bg-black/60 backdrop-blur-xl border-b border-white/10 py-3" : "bg-transparent"
      }`}>
        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="flex items-center gap-2">
          <div className="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center font-bold">S</div>
          <span className="font-black tracking-tighter text-xl">SMA<span className="text-blue-500">.</span></span>
        </motion.div>
        <div className="flex gap-8 text-xs font-bold uppercase tracking-widest text-zinc-400">
          {["About", "Skills", "Projects"].map((item) => (
            <a key={item} href={`#${item.toLowerCase()}`} className="hover:text-blue-500 transition-colors">{item}</a>
          ))}
        </div>
      </nav>

      {/* 3. HERO SECTION */}
      <section id="about" className="relative pt-44 pb-20 px-6 max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
        <motion.div 
          initial={{ opacity: 0, x: -50 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ duration: 0.8 }}
        >
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold mb-6">
            <Terminal size={14}/> AVAILABLE FOR PROJECTS
          </div>
          <h1 className="text-6xl md:text-8xl font-black leading-[0.9] mb-8">
            DIGITAL <br /> 
            <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-cyan-400 to-indigo-500">ARCHITECT</span>
          </h1>
          <p className="text-zinc-400 text-lg max-w-md leading-relaxed mb-10 border-l-2 border-blue-500 pl-6">
            Saya <span className="text-white font-bold">{DATA.name}</span>, anak ke-2 dari 3 bersaudara,alamat saya saat ini ada di komplek rancamanyar regency 1,desa rancamanyar,kecamatan baleendah,kabubaten bandung,jawa barat,indonesia. Saat ini saya kelas 11 di SMK Assalaam Bandung jurusan RPL. Di sini, saya tidak hanya belajar coding (web & aplikasi), tapi juga mendalami ilmu TKJ. Saya kompeten dalam instalasi ISO, IOS, OS, serta troubleshooting kerusakan perangkat keras laptop dan PC.
          </p>
          <div className="flex gap-4">
            <button className="px-8 py-4 bg-blue-600 hover:bg-blue-500 rounded-xl font-bold transition-all flex items-center gap-2 shadow-lg shadow-blue-600/20">
              Get in Touch <ChevronRight size={18}/>
            </button>
            <a href={`https://${DATA.github}`} className="p-4 bg-zinc-900 border border-white/5 rounded-xl hover:bg-zinc-800 transition-all">
              <Github />
            </a>
          </div>
        </motion.div>

        <motion.div 
          initial={{ opacity: 0, scale: 0.8 }}
          animate={{ opacity: 1, scale: 1 }}
          className="relative flex justify-center"
        >
          <div className="relative w-80 h-96 bg-zinc-900 rounded-[40px] border border-white/10 overflow-hidden group">
            <img src="/port.jpg" alt="Satria" className="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
            <div className="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
            <div className="absolute bottom-6 left-6">
              <p className="text-xs font-bold text-blue-500 uppercase">Education</p>
              <p className="text-sm font-medium">{DATA.school}</p>
            </div>
          </div>
          {/* Decorative Elements */}
          <div className="absolute -bottom-10 -right-10 w-32 h-32 bg-blue-500/20 blur-3xl animate-pulse"></div>
        </motion.div>
      </section>

      {/* 4. SKILLS SECTION (Glassmorphism Cards) */}
      <section id="skills" className="py-24 px-6 max-w-7xl mx-auto">
        <div className="mb-16">
          <h2 className="text-sm font-black text-blue-500 tracking-[0.3em] uppercase mb-2">Technologies</h2>
          <h3 className="text-4xl font-bold">Tech Stack <span className="text-zinc-600">&</span> Expertise.</h3>
        </div>
        <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
          {DATA.skills.map((skill, i) => (
            <motion.div
              key={skill.name}
              whileHover={{ y: -5, backgroundColor: "rgba(39, 39, 42, 0.8)" }}
              className="p-6 rounded-2xl bg-zinc-900/40 border border-white/5 backdrop-blur-sm text-center"
            >
              <p className="font-bold text-lg mb-1">{skill.name}</p>
              <div className="w-full h-1 bg-zinc-800 rounded-full overflow-hidden">
                <motion.div 
                  initial={{ width: 0 }}
                  whileInView={{ width: `${skill.level}%` }}
                  className="h-full bg-blue-500"
                />
              </div>
            </motion.div>
          ))}
        </div>
      </section>

      {/* 5. PROJECTS SECTION (Modern Grid) */}
      <section id="projects" className="py-24 px-6 max-w-7xl mx-auto">
        <div className="grid lg:grid-cols-3 gap-8">
          {DATA.projects.map((proj, i) => (
            <motion.div 
              key={i}
              initial={{ opacity: 0, y: 30 }}
              whileInView={{ opacity: 1, y: 0 }}
              transition={{ delay: i * 0.1 }}
              className="group relative p-1 rounded-[32px] bg-gradient-to-b from-white/10 to-transparent hover:from-blue-500/50 transition-all duration-500"
            >
              <div className="bg-[#0a0a0a] rounded-[31px] p-8 h-full flex flex-col">
                <div className="mb-6 flex justify-between items-start">
                  <div className="p-3 bg-zinc-900 rounded-2xl group-hover:text-blue-400 transition-colors">
                    {i === 0 ? <Layout /> : i === 1 ? <Smartphone /> : <Database />}
                  </div>
                  <ExternalLink size={20} className="text-zinc-600 group-hover:text-white transition-colors cursor-pointer"/>
                </div>
                <h4 className="text-xs font-black text-blue-500 uppercase tracking-widest mb-2">{proj.category}</h4>
                <h3 className="text-2xl font-bold mb-4">{proj.title}</h3>
                <p className="text-zinc-400 text-sm leading-relaxed mb-8 flex-grow">{proj.desc}</p>
                <div className="flex flex-wrap gap-2 pt-6 border-t border-white/5">
                  {proj.tech.map(t => (
                    <span key={t} className="text-[10px] font-bold px-3 py-1 bg-zinc-900 rounded-lg text-zinc-400 border border-white/5">{t}</span>
                  ))}
                </div>
              </div>
            </motion.div>
          ))}
        </div>
      </section>

      {/* 6. CONTACT SECTION (Futuristic Call to Action) */}
      <section id="contact" className="py-32 px-6 text-center">
        <motion.div 
          whileInView={{ y: [20, 0], opacity: [0, 1] }}
          className="max-w-3xl mx-auto"
        >
          <div className="w-20 h-20 bg-blue-600/20 rounded-3xl flex items-center justify-center text-blue-500 mx-auto mb-10 rotate-12">
            <Mail size={40} />
          </div>
          <h2 className="text-5xl md:text-7xl font-black mb-6 italic tracking-tighter">LET'S CONNECT.</h2>
          <p className="text-zinc-400 mb-12 text-lg italic">"Turning complex problems into elegant software solutions."</p>
          <div className="flex flex-col md:flex-row gap-6 justify-center items-center">
            <a href={`mailto:${DATA.email}`} className="group relative px-10 py-5 bg-white text-black rounded-2xl font-black transition-transform hover:scale-105 overflow-hidden">
              <span className="relative z-10 uppercase tracking-tighter">Start a Conversation</span>
            </a>
          </div>
        </motion.div>
      </section> 

      {/* FOOTER */}
      <footer className="py-10 border-t border-white/5 px-10 flex flex-col md:flex-row justify-between items-center gap-6">
        <p className="text-zinc-600 text-[10px] font-bold tracking-widest uppercase italic">© 2026 Designed Satria Maulana Asrul</p>
        <p> <div className="flex items-center gap-3 text-zinc-500 font-mono text-sm">
              <MapPin size={16} className="text-blue-500"/> {DATA.address}
            </div></p>
        <div className="flex gap-6 text-zinc-500 uppercase text-[10px] font-black tracking-widest">
           <a href={`https://${DATA.github}`} className="hover:text-white transition-colors">GitHub</a>
             <a href="#" className="hover:text-white transition-colors">WhatsApp</a>
        </div>
      </footer>
    </main>
  );
}


